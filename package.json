{
  "name": "playwright-test-generator",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted generator that turns manual test cases written in Excel/Word into executable Playwright tests.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "parse": "node src/cli.js parse",
    "analyze": "node src/cli.js analyze",
    "generate": "node src/cli.js generate",
    "test": "playwright test",
    "report": "node src/cli.js report",
    "install:browsers": "playwright install chromium",
    "mocks": "node scripts/start-mocks.js",
    "generate-and-test": "node src/cli.js generate-and-test",
    "demo": "node src/cli.js generate-and-test --offline",
    "demo:youtube": "node src/cli.js generate-and-test --input input/youtube-tests.xlsx --offline",
    "build:inputs": "node scripts/build-input-files.js && node scripts/build-orangehrm-inputs.js && node scripts/build-carinfo-inputs.js && node scripts/build-tneb-inputs.js",
    "lint": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "demo:orangehrm": "node src/cli.js generate-and-test --input input/orangehrm-tests.xlsx --offline",
    "demo:saucedemo": "node src/cli.js generate-and-test --input input/sample-tests.xlsx --offline",
    "demo:carinfo": "node src/cli.js generate-and-test --input input/carinfo-tests.docx --offline",
    "demo:tneb": "node src/cli.js generate-and-test --input input/tneb-tests.docx --offline",
    "names": "node scripts/dump-accessible-names.js"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "llm",
    "ai",
    "test-case-generation"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "docx": "^9.7.1"
  }
}
