# Credentials for the LLM analyzer (src/analyzer/llmProvider.js).
#
# Without a key the CLI falls back to the offline rule-based analyzer and says
# so; every other stage of the pipeline behaves identically.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the analyzer model (default: claude-opus-5).
# ANALYZER_MODEL=claude-opus-5

# Optional: launch a browser already installed on this machine instead of the
# one Playwright downloads. Use this when `playwright install` cannot complete
# (a proxy that truncates the download, or antivirus removing the binary).
#   PW_CHANNEL=chrome
#   PW_CHANNEL=msedge

# Optional: record video as well as traces and screenshots. Off by default
# because video is the one artifact that needs Playwright's ffmpeg binary.
# PW_VIDEO=1
